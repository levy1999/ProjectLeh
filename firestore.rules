rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "levipantojo@gmail.com" && request.auth.token.email_verified == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    function uidUnchanged() {
      return !('ownerId' in request.resource.data) ||
        request.resource.data.ownerId == request.auth.uid;
    }

    function uidNotModified() {
      return !('ownerId' in request.resource.data) ||
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidPatient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.ownerId == request.auth.uid;
    }

    function isValidSession(data) {
      return data.patient_name is string && data.patient_name.size() > 0 &&
             data.session_date is string && data.session_time is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidNote(data) {
      return data.title is string && data.title.size() > 0 &&
             data.content is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidWaitingItem(data) {
      return data.patient_name is string && data.patient_name.size() > 0 &&
             data.ownerId == request.auth.uid;
    }

    function isValidProfile(data) {
      return data.ownerId == request.auth.uid &&
             (!('is_premium' in data) || data.is_premium is bool) &&
             (!('subscription_expiry' in data) || data.subscription_expiry is string);
    }

    function isValidMedicalPatient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.age is string &&
             data.profession is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidMedicalRecord(data) {
      return data.patientId is string &&
             data.type in ['interview', 'assessment', 'evolution', 'vitals'] &&
             data.date is string &&
             data.ownerId == request.auth.uid &&
             (!('history' in data) || data.history is list);
    }

    function isValidPatientFile(data) {
      return data.patientId is string &&
             data.name is string && data.name.size() > 0 &&
             data.type is string && data.type.size() > 0 &&
             data.contentUrl is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidReminder(data) {
      return data.patient_name is string && data.patient_name.size() > 0 &&
             data.type is string && data.type.size() > 0 &&
             data.description is string && data.description.size() > 0 &&
             data.ownerId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /patients/{patientId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidPatient(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidPatient(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidSession(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidSession(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidNote(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidNote(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /waitingList/{waitingId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidWaitingItem(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidWaitingItem(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /medicalPatients/{patientId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidMedicalPatient(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidMedicalPatient(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /medicalRecords/{recordId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidMedicalRecord(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidMedicalRecord(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /patientFiles/{fileId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidPatientFile(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidPatientFile(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidReminder(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidReminder(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if isAuthenticated() && (profileId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidProfile(request.resource.data);
      allow update: if isAuthenticated() && (profileId == request.auth.uid || isAdmin()) && isValidProfile(request.resource.data) && uidNotModified();
      allow delete: if isAuthenticated() && (profileId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && request.auth.token.email == "levipantojo@gmail.com");
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || (isAuthenticated() && request.auth.token.email == "levipantojo@gmail.com");
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
